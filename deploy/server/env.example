# Absolute paths keep production resources separate from each release.
API_IMAGE=congcong-school-api:v1.9.0
NGINX_IMAGE=nginx:stable-alpine
WEB_ORIGIN=http://localhost:8080
WEB_LISTEN=8080
COOKIE_SECURE=false
ACCOUNT_STATE_DIR=/srv/congcong/accounts/state
ACCOUNT_CONFIG_DIR=/srv/congcong/accounts/config
NGINX_CONFIG=/srv/congcong/releases/v1.9.0/source/docker/nginx.conf
FRONTEND_DIR=/srv/congcong/releases/v1.9.0/frontend
RESOURCE_DIR=/srv/congcong/site
